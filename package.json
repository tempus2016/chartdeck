{
  "name": "chartdeck",
  "version": "1.1.0",
  "private": true,
  "description": "Bars, gauges and charts for Home Assistant dashboards, set up entirely from the visual editor",
  "main": "dist/chartdeck-card.js",
  "scripts": {
    "build": "npm run lint && npm run rollup",
    "lint": "eslint .",
    "rollup": "rollup -c",
    "start": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tempus2016/chartdeck.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "chart",
    "gauge",
    "bar"
  ],
  "author": "tempus2016",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tempus2016/chartdeck/issues"
  },
  "homepage": "https://tempus2016.github.io/chartdeck/",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rollup": "^4.65.1",
    "rollup-plugin-serve": "^3.0.0",
    "semantic-release": "^25.0.9",
    "ts-lit-plugin": "^2.0.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
